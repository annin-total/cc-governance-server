# ローカル開発専用の設定値。機密情報は含まない（ダミーの値）。
# entry.sh は実行基盤で /mnt/data/secrets/cc-governance-server.env を読む設計であり、
# compose はこのファイルを同じパスへマウントすることで、契約ゲートを含む entry.sh を
# 本番と同じ経路でローカルでも通す。
# DB は既定で SQLite。MySQL で動かすときは下の 2 行のコメントを入れ替え、docker compose --profile mysql up で起動する。
DB_DSN=sqlite:////app/data/dev.db
# DB_DSN=mysql://ccgov:dev-db-password@mysql:3306/ccgov
INGEST_TOKEN=dev-token
CSV_DIR=/app/data/csv
# entry.sh は set -u の下で $PKG_PROXY を参照するため、空でも定義を消さない。
PKG_PROXY=
ADMIN_PATH=dev-admin
ADMIN_PASSWORD=dev-password
